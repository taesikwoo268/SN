{
  "name": "social-network",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "start:api": "bun run --cwd apps/api start",
    "typecheck": "bun --filter '*' typecheck",
    "typecheck:api": "bun run --cwd apps/api typecheck",
    "test": "bun --filter '*' test",
    "test:api": "bun run --cwd apps/api test",
    "db:check": "bun run --cwd apps/api db:check",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:studio": "bun run --cwd apps/api db:studio"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
